---
// Página de inicio del MVP: presenta la propuesta editorial, la curiosidad
// destacada, categorías y acceso a enigmas/suscripción.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CuriosityCard from '../components/CuriosityCard.astro';
import SubscribeBox from '../components/SubscribeBox.astro';
const curiosidades = (await getCollection('curiosidades')).sort((a,b) => b.data.publishedAt.localeCompare(a.data.publishedAt));
const featured = curiosidades[0];
const latest = curiosidades.slice(1, 7);
const categories = [...new Set(curiosidades.map((item) => item.data.category))];
---
<BaseLayout title="SoyCurioso — curiosidades y enigmas diarios" description="MVP de una web de curiosidades, newsletter diaria y pasatiempos.">
  <section class="wrapper hero">
    <div>
      <p class="eyebrow">MVP funcional</p>
      <h1>Una curiosidad diaria para mentes inquietas.</h1>
      <p class="lead">Ciencia, naturaleza, historia, filosofía, misterio, true crime y enigmas breves con imagen, etiquetas y desarrollo claro.</p>
      <div class="meta">
        <a class="button" href="/soycurioso/curiosidades/">Explorar curiosidades</a>
        <a class="button secondary" href="/soycurioso/enigmas/">Resolver enigmas</a>
      </div>
    </div>
    <article class="hero-card">
      <img src={featured.data.image} alt={`Imagen de ${featured.data.title}`} />
      <div class="hero-card-content">
        <p class="eyebrow">Curiosidad del día</p>
        <h2>{featured.data.title}</h2>
        <p class="lead">{featured.data.summary}</p>
        <a class="button" href={`/soycurioso/curiosidades/${featured.id}/`}>Leer ahora</a>
      </div>
    </article>
  </section>

  <section class="wrapper section">
    <div class="section-title"><h2>Categorías</h2><a href="/soycurioso/categorias/">Ver todas</a></div>
    <div class="grid">
      {categories.map((category) => <a class="card card-body" href={`/soycurioso/categorias/#${category.toLowerCase()}`}><h3>{category}</h3><p>Curiosidades clasificadas para encontrar justo el tema que apetece.</p></a>)}
    </div>
  </section>

  <section class="wrapper section">
    <div class="section-title"><h2>Últimas curiosidades</h2><a href="/soycurioso/curiosidades/">Archivo completo</a></div>
    <div class="grid">{latest.map((entry) => <CuriosityCard entry={entry} />)}</div>
  </section>

  <section class="wrapper section">
    <div class="panel puzzle-box">
      <p class="eyebrow">Pasatiempos</p>
      <h2>Enigmas con pistas progresivas</h2>
      <p class="lead">Zona para lógica tipo casas de colores, misterios deductivos y mini escape rooms. Aquí nadie hace trampas... salvo todo el mundo.</p>
      <a class="button" href="/soycurioso/enigmas/">Entrar en enigmas</a>
    </div>
  </section>
  <SubscribeBox />
</BaseLayout>
