---
// Archivo buscable de curiosidades. El filtrado se hace en cliente para que
// GitHub Pages pueda servirlo como web estática sin backend.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CuriosityCard from '../../components/CuriosityCard.astro';
import SearchFilters from '../../components/SearchFilters.astro';
const curiosidades = (await getCollection('curiosidades')).sort((a,b) => b.data.publishedAt.localeCompare(a.data.publishedAt));
const categories = [...new Set(curiosidades.map((item) => item.data.category))];
---
<BaseLayout title="Curiosidades — SoyCurioso">
  <section class="wrapper article">
    <p class="eyebrow">Archivo</p>
    <h1>Curiosidades buscables</h1>
    <p class="lead">Filtra por texto, categoría o tipo de contenido. En el futuro aquí entrará Pagefind si el catálogo crece.</p>
    <SearchFilters categories={categories} />
    <div class="grid">
      {curiosidades.map((entry) => <div data-search-card data-kind="curiosidad" data-category={entry.data.category}><CuriosityCard entry={entry} /></div>)}
    </div>
  </section>
</BaseLayout>
